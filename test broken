            if otherRoot then
                local distance = (localRoot - otherRoot.Position).Magnitude
                if distance <= AUTO_M1_MAX_DISTANCE and autoM1AnimsPlaying(player.Character) then
                    return true
                end
            end
        end
    end

    return false
end

