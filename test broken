local function setupDashModifier(char)
    local hrp = char:WaitForChild("HumanoidRootPart")

    local childAdded = hrp.ChildAdded:Connect(function(c)
        if c.Name ~= "dodgevelocity" then
            return
        end

        local velclone = c:Clone()
        velclone.Name = "newdodgevelocity"
        velclone.Parent = hrp

        task.spawn(function()
            while c.Parent == hrp and velclone.Parent == hrp do
                rs.RenderStepped:Wait()

                if not c.Parent or not velclone.Parent then
                    break
                end

                local velocity = c.Velocity
                c.P = 0

                local currentMultiplier = getDashMultiplier(char)

                local sideDashAnim =
                    isAnimationRunning(char, 10480796021)
                    or isAnimationRunning(char, 10480793962)

                local boost = 1

                if sideDashAnim and sideDashBoostEnabled then
                    boost = SIDE_DASH_BOOST
                end

                velclone.Velocity = Vector3.new(
                    velocity.X * currentMultiplier * boost,
                    velocity.Y,
                    velocity.Z * currentMultiplier * boost
                )
            end
        end)

        task.wait()

        local sideDashAnim =
            isAnimationRunning(char, 10480796021)
            or isAnimationRunning(char, 10480793962)

        if sideDashAnim then
            sideDashAnim:AdjustSpeed(1.0)
        end
    end)

    local childRemoved = hrp.ChildRemoved:Connect(function(c)
        if c.Name == "dodgevelocity" then
            local newvel = hrp:FindFirstChild("newdodgevelocity")

            if newvel then
                newvel:Destroy()
