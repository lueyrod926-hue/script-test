local function createToggle(parent, text, enabled, callback)

    local button = new("TextButton", {
        Size = UDim2.fromOffset(34, 18),
        Position = UDim2.new(1, -48, 0.5, -9),
        BackgroundColor3 = enabled and COLORS.Purple or COLORS.ToggleOff,
        BorderSizePixel = 0,
        Text = "",
        AutoButtonColor = false
    }, parent)

    corner(button, 9)

    local knob = new("Frame", {
        Size = UDim2.fromOffset(12, 12),

        Position = enabled
            and UDim2.new(1, -15, 0.5, -6)
            or UDim2.fromOffset(3, 3),

        BackgroundColor3 = Color3.fromRGB(245, 235, 255),
        BorderSizePixel = 0
    }, button)

    corner(knob, 8)

    local state = enabled

    button.MouseButton1Click:Connect(function()

        state = not state

        button.BackgroundColor3 =
            state and COLORS.Purple or COLORS.ToggleOff

        local targetPosition = state
            and UDim2.new(1, -15, 0.5, -6)
            or UDim2.fromOffset(3, 3)

        TweenService:Create(
            knob,
            TweenInfo.new(
                0.2,
                Enum.EasingStyle.Quad,
                Enum.EasingDirection.Out
            ),
            {
                Position = targetPosition
            }
        ):Play()

        if callback then
            callback(state)
        end
    end)

    return button
end

