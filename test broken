local function handleRagdollState(char)
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return false end
    local state = hum:GetState()
    return char:GetAttribute("Ragdoll") == true
        or state == Enum.HumanoidStateType.Ragdoll
        or state == Enum.HumanoidStateType.FallingDown
        or state == Enum.HumanoidStateType.Physics
        or hum.PlatformStand
end

rs.RenderStepped:Connect(function(dt)
    local char = plr.Character
    local hum  = char and char:FindFirstChildOfClass("Humanoid")
    local root = char and char:FindFirstChild("HumanoidRootPart")
    if not (hum and root) then return end

-- CTRL LOCK-ON
    if lockOn and lockedTarget then
        local targetRoot = lockedTarget:FindFirstChild("HumanoidRootPart")
        local targetHumanoid = lockedTarget:FindFirstChildOfClass("Humanoid")

        if not targetRoot or not targetHumanoid or targetHumanoid.Health <= 0 then
            stopLockOn()
        else
            hum.AutoRotate = false

            local direction = Vector3.new(
                targetRoot.Position.X - root.Position.X,
                0,
                targetRoot.Position.Z - root.Position.Z
            )

            if direction.Magnitude > 0.001 then
                root.CFrame = CFrame.lookAt(
                    root.Position,
                    root.Position + direction.Unit
                )
            end
        end
    end

    if trainerEnabled and charRoot then
        local baseY   = getGroundY(charRoot.Position)
        local basePos = Vector3.new(charRoot.Position.X, baseY, charRoot.Position.Z)
        dashRing.CFrame = CFrame.new(basePos)
    end

        if M1Config.Enabled and m1Enabled and cam.CameraType ~= Enum.CameraType.Scriptable then

        local currentAnimId = getPlayingM1Anim(char)

        if currentAnimId and currentAnimId ~= lastAnimId then
            local t = getNearestTarget(root)
            if t then
                m1Target  = t
                lockTimer = M1Config.LockDuration
            else
                m1Target  = nil
                lockTimer = 0
            end
        end

        lastAnimId = currentAnimId
        if not currentAnimId then lastAnimId = nil end

        if lockTimer > 0 then lockTimer = lockTimer - dt end

                local shouldLock = lockTimer > 0 and m1Target ~= nil and m1Target.Parent ~= nil

        if not shouldLock then
            m1Target = nil
            updateM1Highlight(nil)
            if not handleRagdollState(char) then hum.AutoRotate = true end
        else
            local tRoot = m1Target:FindFirstChild("HumanoidRootPart")
            if not tRoot then
                m1Target = nil
                updateM1Highlight(nil)
                if not handleRagdollState(char) then hum.AutoRotate = true end
            else
                updateM1Highlight(m1Target)
                if not handleRagdollState(char) then
                    hum.AutoRotate = false
                    local toTarget = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
                    if toTarget.Magnitude >= 1e-4 then
                        root.CFrame = CFrame.new(root.Position, root.Position + toTarget.Unit)
                    end
                end
            end
        end
    end

    local isHolding = uis:IsKeyDown(AimConfig.AimKey) and aimEnabled

    if isHolding then
        local isSticky = AimConfig.TargetMode:find("Sticky")
        if aimTarget and not aimTarget.Parent then
            aimTarget     = nil
            aimTargetLeft = true
        elseif not aimTarget then
            if not isSticky or not aimTargetLeft then
                aimTarget = getAimTarget()
            end
        elseif not isSticky then
            aimTarget = getAimTarget()
        end
    else
        if not blocking then
            if aimTarget then
                clearAimHighlight(aimTarget)
                prevAimHighlight = nil
            end
            aimTarget     = nil
            aimTargetLeft = false
        end
    end

    if blocking and not isHolding then
        local isSticky = AimConfig.TargetMode:find("Sticky")
        if aimTarget and not aimTarget.Parent then
            aimTarget     = nil
            aimTargetLeft = true
        elseif not aimTarget then
            if not isSticky or not aimTargetLeft then
                aimTarget = getAimTarget()
            end
        elseif not isSticky then
            aimTarget = getAimTarget()
        end
    end

    updateAimHighlight(isHolding and aimTarget or nil)

    if aimTarget ~= aimNoclipTarget then
        setCollision(aimNoclipTarget, false)
        aimNoclipTarget = aimTarget
    end
    if aimTarget then setCollision(aimTarget, AimConfig.Noclip) end

    if isHolding and aimTarget then
        local tRoot = aimTarget:FindFirstChild("HumanoidRootPart")
        local pName = AimConfig.TargetPart
        local tPart = (pName == "Auto" and getAutoPart(aimTarget))
                   or aimTarget:FindFirstChild(pName)
                   or tRoot

        if tPart and tRoot and not handleRagdollState(char) then
            hum.AutoRotate = false

            local dist     = (root.Position - tRoot.Position).Magnitude
            local velocity = tRoot.AssemblyLinearVelocity
            local velMag   = velocity.Magnitude

            local toTargetFlat = Vector3.new(tRoot.Position.X - root.Position.X, 0, tRoot.Position.Z - root.Position.Z)
            local velocityFlat = Vector3.new(velocity.X, 0, velocity.Z)

            local approachDot = 0
            if toTargetFlat.Magnitude > 1e-4 and velocityFlat.Magnitude > 1e-4 then
                approachDot = toTargetFlat.Unit:Dot(velocityFlat.Unit)
            end

            local isApproaching   = approachDot < -0.15
            local lateralVelocity = velocityFlat - (toTargetFlat.Unit * math.max(0, -approachDot) * velocityFlat.Magnitude)

            local basePred = AimConfig.Prediction
            local finalPred

            if isApproaching then
                local af = math.abs(approachDot)
                local df = math.clamp(dist / 20, 0, 1)
                finalPred = basePred * (0.15 + 0.25 * df) * (1 - af * 0.75)
            else
                local smoothedVelMag = prevVelMag + (velMag - prevVelMag) * 0.25
                prevVelMag           = smoothedVelMag
                local lateralBoost   = math.clamp(1 + smoothedVelMag / 30, 1, 2.5)
                local closeBoost     = dist < 25 and 1.4 or 1
                finalPred            = basePred * lateralBoost * closeBoost
            end

            local predictedVel = isApproaching and lateralVelocity or velocity
            local targetPos    = tPart.Position + predictedVel * finalPred

            local lookFlat    = Vector3.new(root.CFrame.LookVector.X, 0, root.CFrame.LookVector.Z)
            local toTargetVec = Vector3.new(targetPos.X - root.Position.X, 0, targetPos.Z - root.Position.Z)

            if lookFlat.Magnitude > 1e-4 and toTargetVec.Magnitude > 1e-4 then
                local angle = math.min(
                    math.acos(math.clamp(lookFlat.Unit:Dot(toTargetVec.Unit), -1, 1)),
                    math.rad(45)
                )
                local turnSpeed  = getTurnSpeed(AimConfig.Smoothing) * math.clamp(1 + velMag / 100, 1, 1.5)
                local direction  = lookFlat:Cross(toTargetVec).Y >= 0 and 1 or -1
                local currentRot = math.atan2(lookFlat.X, lookFlat.Z)
                local newRot     = currentRot + angle * turnSpeed * direction
                root.CFrame      = CFrame.new(root.Position, root.Position + Vector3.new(math.sin(newRot), 0, math.cos(newRot)))
            end
        end
    else
        if not handleRagdollState(char) and not (M1Config.Enabled and m1Enabled and lockTimer > 0) then
            hum.AutoRotate = true
        end
    end
end)

