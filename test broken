-- OPEN MENU
--==================================================

local function openMenu()

if menuAnimating or menuVisible then
    return
end

menuAnimating = true
menuVisible = true

main.Visible = true

-- Start from slightly smaller + invisible
main.BackgroundTransparency = 1
menuScale.Scale = 0.88
menuGlow.Transparency = 1

for object in pairs(originalTransparency) do

    if object and object.Parent then

        if object:IsA("UIStroke") then
            object.Transparency = 1

        elseif object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then

            object.BackgroundTransparency = 1
            object.TextTransparency = 1

        elseif object:IsA("ImageLabel")
            or object:IsA("ImageButton") then

            object.BackgroundTransparency = 1
            object.ImageTransparency = 1

        else

            object.BackgroundTransparency = 1
        end
    end
end

-- Main panel
TweenService:Create(
    main,
    openInfo,
    {
        BackgroundTransparency = 1
    }
):Play()

-- Scale
TweenService:Create(
    menuScale,
    openInfo,
    {
        Scale = 1
    }
):Play()

-- Glow
TweenService:Create(
    menuGlow,
    TweenInfo.new(
        0.4,
        Enum.EasingStyle.Sine,
        Enum.EasingDirection.Out
    ),
    {
        Transparency = 0.3,
        Thickness = 2
    }
):Play()

-- Fade all UI elements
for object, values in pairs(originalTransparency) do

    if object and object.Parent then

        if object:IsA("UIStroke") then

            TweenService:Create(
                object,
                openInfo,
                {
                    Transparency = values.Transparency
                }
            ):Play()

        elseif object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then

            TweenService:Create(
                object,
                openInfo,
                {
                    BackgroundTransparency =
                        values.BackgroundTransparency,

                    TextTransparency =
                        values.TextTransparency or 0
                }
            ):Play()

        elseif object:IsA("ImageLabel")
            or object:IsA("ImageButton") then

            TweenService:Create(
                object,
                openInfo,
                {
                    BackgroundTransparency =
                        values.BackgroundTransparency,

                    ImageTransparency =
                        values.ImageTransparency or 0
                }
            ):Play()

        else

            TweenService:Create(
                object,
                openInfo,
                {
                    BackgroundTransparency =
                        values.BackgroundTransparency
                }
            ):Play()

        end
    end
end

task.delay(0.36, function()
    menuAnimating = false
end)

end

