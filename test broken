local function autoM1AnimsPlaying(otherCharacter)
    local otherHumanoid = otherCharacter:FindFirstChildOfClass("Humanoid")
    if not otherHumanoid then return false end
    local otherAnimator = otherHumanoid:FindFirstChildOfClass("Animator")
    if not otherAnimator then return false end

    local foundBackdash, foundPair = false, false

    for _, track in ipairs(otherAnimator:GetPlayingAnimationTracks()) do
        local id = track.Animation.AnimationId
        if id == BACKDASH then foundBackdash = true end
        for _, pairAnim in ipairs(PAIR_ANIMS) do
            if id == pairAnim then foundPair = true end
        end
        if foundBackdash and foundPair then return true end
    end

    return false
end

