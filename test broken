local menuVisible = false
local menuAnimating = false

main.Visible = false
menuScale.Scale = 0.88
menuGlow.Transparency = 1

local openInfo = TweenInfo.new(
0.35,
Enum.EasingStyle.Quint,
Enum.EasingDirection.Out
)

local closeInfo = TweenInfo.new(
0.25,
Enum.EasingStyle.Quint,
Enum.EasingDirection.In
)

-- Store the original transparency of UI objects
local originalTransparency = {}

for _, object in ipairs(main:GetDescendants()) do

    if object:IsA("GuiObject") then

        originalTransparency[object] = {
            BackgroundTransparency = object.BackgroundTransparency
        }

        if object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then

            originalTransparency[object].TextTransparency =
                object.TextTransparency

        elseif object:IsA("ImageLabel")
            or object:IsA("ImageButton") then

            originalTransparency[object].ImageTransparency =
                object.ImageTransparency
        end

    elseif object:IsA("UIStroke") then

        if object ~= menuGlow then
            originalTransparency[object] = {
                Transparency = object.Transparency
            }
        end
    end
end
    

local function setMenuHidden()

main.BackgroundTransparency = 1
menuScale.Scale = 0.88
menuGlow.Transparency = 1

for object, values in pairs(originalTransparency) do

    if object and object.Parent then

        if object:IsA("UIStroke") then

            object.Transparency = 1

        elseif object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then

            object.BackgroundTransparency = 1
            object.TextTransparency = 1

        elseif object:IsA("ImageLabel")
            or object:IsA("ImageButton") then

            object.BackgroundTransparency = 1
            object.ImageTransparency = 1

        else

            object.BackgroundTransparency = 1

           end
        end
     end
  end
local function restoreMenuTransparency()

main.BackgroundTransparency = 1

for object, values in pairs(originalTransparency) do

    if object and object.Parent then

        if object:IsA("UIStroke") then

            object.Transparency = values.Transparency

        elseif object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then

            object.BackgroundTransparency =
                values.BackgroundTransparency

            object.TextTransparency =
                values.TextTransparency or 0

        elseif object:IsA("ImageLabel")
            or object:IsA("ImageButton") then

            object.BackgroundTransparency =
                values.BackgroundTransparency

            object.ImageTransparency =
                values.ImageTransparency or 0

        else

            object.BackgroundTransparency =
                values.BackgroundTransparency

        end
    end
end

end

setMenuHidden()

