local function getAimTarget()
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then
        return
    end

    local target, dist = nil, math.huge
    local isCursor = AimConfig.TargetMode:find("Mouse")

    for _, v in pairs((workspace:FindFirstChild("Live") or workspace):GetChildren()) do
        local isPlayer = plrs:GetPlayerFromCharacter(v)

        if isPlayer and v ~= plr.Character then
            if v:IsA("Model") and v:FindFirstChild("HumanoidRootPart") then
                local tRoot = v.HumanoidRootPart
                local mag = (root.Position - tRoot.Position).Magnitude

                if mag <= AimConfig.MaxRange then
                    if isCursor then
                        local pos, onScreen = cam:WorldToViewportPoint(tRoot.Position)

                        if onScreen then
                            local sDist = (
                                Vector2.new(mouse.X, mouse.Y) -
                                Vector2.new(pos.X, pos.Y)
                            ).Magnitude

                            if sDist < dist then
                                dist = sDist
                                target = v
                            end
                        end
                    elseif mag < dist then
                        dist = mag
                        target = v
                    end
                end
            end
        end
    end

    return target
end
local function getAutoPart(char)
