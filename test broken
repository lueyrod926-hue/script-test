local function getTurnSpeed(s)
    if s <= 0 then return 0.9 end
    local n = s / 100
    return n < 0.5
        and (0.5 * (1 - n * 2) + 0.05)
        or  (0.15 * (0.1 ^ ((n - 0.5) * 2)))
end

