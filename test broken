local function closeMenu()

if menuAnimating or not menuVisible then
    return
end

menuAnimating = true
menuVisible = false

-- Fade panel
TweenService:Create(
    main,
    closeInfo,
    {
        BackgroundTransparency = 1
    }
):Play()

-- Shrink
TweenService:Create(
    menuScale,
    closeInfo,
    {
        Scale = 0.88
    }
):Play()

-- Glow disappears
TweenService:Create(
    menuGlow,
    closeInfo,
    {
        Transparency = 1
    }
):Play()

-- Fade UI
for object in pairs(originalTransparency) do

    if object and object.Parent then

        if object:IsA("UIStroke") then

            TweenService:Create(
                object,
                closeInfo,
                {
                    Transparency = 1
                }
            ):Play()

        elseif object:IsA("TextLabel")
            or object:IsA("TextButton")
            or object:IsA("TextBox") then

            TweenService:Create(
                object,
                closeInfo,
                {
                    BackgroundTransparency = 1,
                    TextTransparency = 1
                }
            ):Play()

        elseif object:IsA("ImageLabel")
            or object:IsA("ImageButton") then

            TweenService:Create(
                object,
                closeInfo,
                {
                    BackgroundTransparency = 1,
                    ImageTransparency = 1
                }
            ):Play()

        else

            TweenService:Create(
                object,
                closeInfo,
                {
                    BackgroundTransparency = 1
                }
            ):Play()

        end
    end
end

