end

local function getDashMultiplier(char)
    if not dashEnabled then return 1.0 end
    local hum = char and char:FindFirstChildOfClass("Humanoid")
    if not hum then return 1.0 end
    local hpRatio      = math.clamp(hum.Health / hum.MaxHealth, 0, 1)
    local naturalTiles = DashConfig.NaturalMinHP + (DashConfig.NaturalFullHP - DashConfig.NaturalMinHP) * hpRatio
    if isAirborne(char) then
        local currentTiles = DashConfig.AirMinHP + (DashConfig.AirFullHP - DashConfig.AirMinHP) * hpRatio
        return currentTiles / naturalTiles
    else
        local currentTiles = DashConfig.GroundMinHP + (DashConfig.GroundFullHP - DashConfig.GroundMinHP) * hpRatio
        return currentTiles / naturalTiles
    end
end

