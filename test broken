end

local function dropBlock()
    if blocking then
        blocking         = false
        unblockScheduled = false
        sendBlock(false)
        if aimTarget then
            clearAimHighlight(aimTarget)
            prevAimHighlight = nil
        end
        aimTarget     = nil
        aimTargetLeft = false
    end
end

local function getPlayerRange(attacker)
    local lastDash = recentSidedash[attacker]
    if lastDash and (tick() - lastDash) < SIDEDASH_RANGE_EXPIRY then
        return SIDEDASH_RANGE
    end
    return DETECTION_RANGE
end

local function onM1Detected(attacker)
    if not autoblockEnabled then return end
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local otherRoot = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
    if not otherRoot then return end
    if (root.Position - otherRoot.Position).Magnitude > getPlayerRange(attacker) then return end

    local now = tick()
    if (now - lastUnblockTime) < REBLOCK_DELAY then return end

    if not blocking then
        blocking = true
        sendBlock(true)
    end
    if not unblockScheduled then
        unblockScheduled = true
        task.delay(getPingScaledHold(), doUnblock)
    end
end

local function onSidedashDetected(attacker)
    if not autoblockEnabled then return end
    local root = plr.Character and plr.Character:FindFirstChild("HumanoidRootPart")
    if not root then return end
    local otherRoot = attacker.Character and attacker.Character:FindFirstChild("HumanoidRootPart")
    if not otherRoot then return end
    if (root.Position - otherRoot.Position).Magnitude <= SIDEDASH_RANGE then
        recentSidedash[attacker] = tick()
    end
end

local function watchPlayer(player)
    if player == plr then return end
    local function onChar(char)
        local hum = char:WaitForChild("Humanoid", 10)
        if not hum then return end
        local animator = hum:WaitForChild("Animator", 10)
        if not animator then return end
        animator.AnimationPlayed:Connect(function(track)
            local id = track.Animation and track.Animation.AnimationId
            if not id then return end
            if M1_ANIMS[id] then
                onM1Detected(player)
            elseif SIDEDASH_ANIMS[id] then
                onSidedashDetected(player)
            end
        end)
    end
    if player.Character then onChar(player.Character) end
    player.CharacterAdded:Connect(onChar)
end

for _, p in ipairs(plrs:GetPlayers()) do task.spawn(watchPlayer, p) end
plrs.PlayerAdded:Connect(watchPlayer)

