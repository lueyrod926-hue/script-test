local function setCollision(character, shouldNoclip)
    if not character then return end
    if shouldNoclip then
        if not partCache[character] then
            local pList, oColl = {}, {}
            for _, part in ipairs(character:GetDescendants()) do
                if part:IsA("BasePart") then
                    pList[#pList + 1] = part
                    oColl[part]       = part.CanCollide
                end
            end
            partCache[character]          = pList
            originalCollisions[character] = oColl
        end
        for _, p in ipairs(partCache[character]) do p.CanCollide = false end
    else
        local oColl = originalCollisions[character]
        if oColl then
            for part, state in pairs(oColl) do
                if part and part.Parent then part.CanCollide = state end
            end
            originalCollisions[character] = nil
            partCache[character]          = nil
        end
    end
end

